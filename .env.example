DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Connection string for the non-privileged app_runtime role (see
# db/migrations/0001_create_app_role.sql and db/README.md). Same host/db
# as DATABASE_URL, different user/password. Required by the RLS isolation
# tests in db/migrations/__tests__/.
APP_RUNTIME_DATABASE_URL=postgresql://app_runtime:password@host/dbname?sslmode=require

# Session JWT secret for signing and verifying session tokens with tenant and role claims.
# Generate with: openssl rand -base64 32
SESSION_JWT_SECRET=<32+ byte random string, generate with: openssl rand -base64 32>
